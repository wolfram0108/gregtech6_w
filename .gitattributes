# Disable autocrlf on generated files, they always generate with LF
# Add any extra files or paths here to make git stop saying they
# are changed when only line endings change.
src/generated/**/.cache/* text eol=lf
src/generated/**/*.json text eol=lf

# ВОСПРОИЗВОДИМОСТЬ МЕЖДУ ПЛАТФОРМАМИ. Всё перечисленное уезжает в jar как есть, поэтому обязано
# быть побайтово одинаковым на любой машине. Репозиторий хранит эти файлы с LF, но Windows при
# выгрузке разворачивает их в CRLF (core.autocrlf=true) — и сборка одного коммита давала РАЗНЫЕ
# архивы: замерено сравнением jar с Windows и с Ubuntu — 597 записей, различие ИСКЛЮЧИТЕЛЬНО в
# переводах строк (времена, права и порядок записей уже совпадали). Здесь окончания строк — часть
# артефакта, а не вопрос стиля, поэтому фиксируются жёстко.
*.json   text eol=lf
*.mcmeta text eol=lf
*.toml   text eol=lf
*.txt    text eol=lf
*.bat    text eol=lf
LICENSE* text eol=lf
COPYING* text eol=lf
NOTICE   text eol=lf

# ИСКЛЮЧЕНИЕ из правила выше (последнее совпадение побеждает): gradlew.bat — исполняемый файл
# Gradle для Windows, в jar не входит, и переводы строк ему менять нельзя. Под правило *.bat
# попадают только вспомогательные скрипты Грегориуса из ресурсов (копирование текстур), которые
# игра не запускает, но которые едут в jar как обычные файлы.
gradlew.bat text eol=crlf
